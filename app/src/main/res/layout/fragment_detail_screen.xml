<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.DetailScreenFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        >

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/arrow_left_to_line_svgrepo_com"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voltar"
            app:layout_constraintBottom_toBottomOf="@+id/imageView"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="@+id/imageView"
            android:layout_marginStart="10dp"
            android:textSize="20sp"
            android:textStyle="bold"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/imagePokemon"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="150dp"
        android:src="@drawable/pok__ball_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageFavoriteIcon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/star_sharp_empty"
        app:layout_constraintBottom_toTopOf="@+id/imagePokemon"
        app:layout_constraintEnd_toEndOf="@+id/imagePokemon" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/imagePokemon"
        android:layout_marginHorizontal="40dp"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_hp"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_hp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

            <TextView
                android:id="@+id/text_hp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/hp"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_hp_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_hp"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_atk"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_atk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/constraint_hp">

            <TextView
                android:id="@+id/text_atk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/atk"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_atk_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_atk"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_def"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_def"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/constraint_atk">

            <TextView
                android:id="@+id/text_def"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/def"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_def_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_def"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_spatk"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_spatk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/constraint_def">

            <TextView
                android:id="@+id/text_spatk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/spatk"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_spatk_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_spatk"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_spdef"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_spdef"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/constraint_spatk">

            <TextView
                android:id="@+id/text_spdef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/spdef"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_spdef_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_spdef"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_spd"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@color/status_spd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/constraint_spdef">

            <TextView
                android:id="@+id/text_spd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:text="@string/spd"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="15dp"
                android:textColor="@color/black"
                />

            <TextView
                android:id="@+id/text_spd_var"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/text_spd"
                android:text="@string/placeholder"
                android:textSize="30sp"
                android:background="@color/transparent"
                android:layout_marginStart="10dp"
                android:textColor="@color/black"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>